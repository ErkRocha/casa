# Copie para `.env` e ajuste. O `.env` não vai para o git.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=casa
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=casa
POSTGRES_PORT=5432

# Senha da role read-only do agente de insights (D-11). A role nasce no
# primeiro boot do banco; se o seu banco é anterior à fase 6, rode `make roles`
# uma vez — o script cria a role e prova que ela não escreve.
INSIGHTS_PASSWORD=troque_esta_senha_tambem

# --- Insights (fase 6) ------------------------------------------------------
# Como o relatório mensal chama o modelo:
#
#   claude_code  CLI local, usa a assinatura do Claude Code. Sem chave de API,
#                sem custo por relatório. É o padrão.
#   api          SDK da Anthropic. Exige `pip install anthropic` e
#                ANTHROPIC_API_KEY. Um relatório mensal gasta poucos milhares
#                de tokens, porque o modelo recebe números já somados.
#
# Em qualquer um dos dois o modelo não calcula nada (regra 7) e não escreve no
# banco (D-11). Trocar o backend não muda o que ele pode fazer.
INSIGHTS_BACKEND=claude_code
INSIGHTS_MODELO=claude-opus-4-8

# Quantas vezes reenviar quando a saída não validar contra o schema (D-12).
INSIGHTS_TENTATIVAS_MAX=3

# Só com INSIGHTS_BACKEND=api.
# ANTHROPIC_API_KEY=

# --- API --------------------------------------------------------------------
API_PORT=8000
APP_ENV=dev

# Autor gravado na tabela `auditoria` quando a escrita vem do painel.
# Agentes sobrescrevem por sessão.
APP_AUTOR_PADRAO=usuario

# --- Web --------------------------------------------------------------------
WEB_PORT=5173
